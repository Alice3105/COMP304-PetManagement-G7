{
  "info": {
    "_postman_id": "pet-shelter-api-2024",
    "name": "Pet Shelter Management API",
    "description": "Complete API collection for Pet Shelter Management System\n\nThis collection includes:\n- Authentication endpoints (Register, Login)\n- Adoption management endpoints (Create, View, Update status)\n\nInstructions:\n1. Update {{baseUrl}} variable with your localhost URL (default: https://localhost:7001)\n2. Run authentication requests first to get API keys\n3. API keys are automatically stored in collection variables\n4. Set {{petId}} variable with a valid pet ID before testing adoption endpoints\n\nAuthentication: Email + BCrypt Password Hashing with Bearer Token (API Key)\n\nEndpoints:\n- Auth: Registration and login for different user roles (Admin, Staff, Veterinarian, ThirdParty)\n- Adoptions: Create, view, and manage adoption applications\n\nCreated for: COMP304 Pet Management Group 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Test Auth Controller",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Controller is working\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.exist;",
              "});",
              "",
              "pm.test(\"Uses simple auth (not Identity)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.usesIdentity).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/test",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "test"]
        },
        "description": "Health check to verify Simple Auth controller is working"
      },
      "response": []
    },
    {
      "name": "2. Register - Admin User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User ID is returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.exist;",
              "    pm.environment.set(\"adminUserId\", jsonData.userId);",
              "});",
              "",
              "pm.test(\"API Key is generated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.apiKey).to.include(\"sk_live_\");",
              "    pm.environment.set(\"adminApiKey\", jsonData.apiKey);",
              "});",
              "",
              "pm.test(\"Role is Admin\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.role).to.equal(\"Admin\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
