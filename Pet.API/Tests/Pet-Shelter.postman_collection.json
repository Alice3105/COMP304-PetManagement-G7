        {
          "name": "17. Create Adoption Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Adoption created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('AdoptionId');",
                  "    pm.expect(jsonData.Status).to.equal('Pending');",
                  "    pm.expect(jsonData.PetId).to.exist;",
                  "    pm.environment.set(\"adoptionId\", jsonData.AdoptionId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PetId\": \"{{petId}}\",\n  \"UserId\": \"{{aliceUserId}}\",\n  \"UserEmail\": \"alice@petshelter.com\",\n  \"UserFirstName\": \"Alice\",\n  \"UserLastName\": \"Huynh\",\n  \"PhoneNumber\": \"555-1234\",\n  \"Address\": \"123 Main St, City, State 12345\",\n  \"HousingType\": \"House\",\n  \"HasYard\": true,\n  \"HasOtherPets\": false,\n  \"OtherPetsDescription\": \"\",\n  \"HasChildren\": false,\n  \"ChildrenAges\": \"\",\n  \"EmploymentStatus\": \"Full-time\",\n  \"Reason\": \"Looking for a loving companion for our family\",\n  \"Status\": \"Pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/adoptions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "adoptions"]
            },
            "description": "Create a new adoption application. Note: Set petId variable first with a valid pet ID from the system."
          },
          "response": []
