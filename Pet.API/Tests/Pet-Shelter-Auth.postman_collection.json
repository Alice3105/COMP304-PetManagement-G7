{
  "info": {
    "_postman_id": "pet-shelter-auth-simple-2024",
    "name": "Pet Shelter API - Simple Authentication",
    "description": "Simple authentication testing for Pet Shelter Management API\n\nInstructions:\n1. Update {{baseUrl}} variable with your localhost URL\n2. Run requests in order\n3. Check DynamoDB after registration\n\nAuthentication: Email + BCrypt Password Hashing\nCreated for: COMP304 Pet Management Group 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Test Auth Controller",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Controller is working\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.exist;",
              "});",
              "",
              "pm.test(\"Uses simple auth (not Identity)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.usesIdentity).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/test",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "test"]
        },
        "description": "Health check to verify Simple Auth controller is working"
      },
      "response": []
    },
    {
      "name": "2. Register - Admin User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User ID is returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.exist;",
              "    pm.environment.set(\"adminUserId\", jsonData.userId);",
              "});",
              "",
              "pm.test(\"API Key is generated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.apiKey).to.include(\"sk_live_\");",
              "    pm.environment.set(\"adminApiKey\", jsonData.apiKey);",
              "});",
              "",
              "pm.test(\"Role is Admin\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.role).to.equal(\"Admin\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@petshelter.com\",\n  \"password\": \"Admin123!\",\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Johnson\",\n  \"role\": \"Admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Register an Admin user - simple email + BCrypt password"
      },
      "response": []
    },
