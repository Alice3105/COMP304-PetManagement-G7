@model Pet.Web.Models.ViewModels.CreatePetViewModel

@{
    ViewData["Title"] = "Add New Pet";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add New Pet</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">Pet Name</label>
                                <input asp-for="Name" class="form-control" placeholder="e.g., Buddy" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label">Species</label>
                                <select asp-for="Species" class="form-select" required>
                                    <option value="">-- Select Species --</option>
                                    <option value="Dog">Dog</option>
                                    <option value="Cat">Cat</option>
                                    <option value="Rabbit">Rabbit</option>
                                    <option value="Bird">Bird</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Species" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Breed" class="form-label">Breed</label>
                                <input asp-for="Breed" class="form-control" placeholder="e.g., Golden Retriever" required />
                                <span asp-validation-for="Breed" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Age" class="form-label">Age (years)</label>
                                <input asp-for="Age" type="number" class="form-control" min="0" max="30" placeholder="e.g., 3" required />
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Gender" class="form-label">Gender</label>
                                <select asp-for="Gender" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Size" class="form-label">Size</label>
                                <select asp-for="Size" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="Small">Small</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Large">Large</option>
                                </select>
                                <span asp-validation-for="Size" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Color" class="form-label">Color</label>
                                <input asp-for="Color" class="form-control" placeholder="e.g., Brown" required />
                                <span asp-validation-for="Color" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the pet's personality, habits, and any special needs" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Photo" class="form-label">Pet Photo</label>
                            <input asp-for="Photo" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                            <small class="form-text text-muted">Allowed formats: JPG, PNG. Max size: 5MB.</small>
                            <span asp-validation-for="Photo" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="Vaccinated" class="form-check-input" type="checkbox" />
                                    <label asp-for="Vaccinated" class="form-check-label">Vaccinated</label>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="Neutered" class="form-check-input" type="checkbox" />
                                    <label asp-for="Neutered" class="form-check-label">Neutered/Spayed</label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="GoodWithKids" class="form-check-input" type="checkbox" />
                                    <label asp-for="GoodWithKids" class="form-check-label">Good with Kids</label>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="GoodWithPets" class="form-check-input" type="checkbox" />
                                    <label asp-for="GoodWithPets" class="form-check-label">Good with Other Pets</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Add Pet</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
