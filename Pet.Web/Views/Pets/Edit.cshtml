@model Pet.Web.Models.ViewModels.PetViewModel

@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Edit Pet: @Model.Name</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.PetId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PetId" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="IntakeDate" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">Pet Name</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label">Species</label>
                                <select asp-for="Species" class="form-select" required>
                                    <option value="Dog">Dog</option>
                                    <option value="Cat">Cat</option>
                                    <option value="Rabbit">Rabbit</option>
                                    <option value="Bird">Bird</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Species" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Breed" class="form-label">Breed</label>
                                <input asp-for="Breed" class="form-control" required />
                                <span asp-validation-for="Breed" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Age" class="form-label">Age (years)</label>
                                <input asp-for="Age" type="number" class="form-control" min="0" max="30" required />
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Gender" class="form-label">Gender</label>
                                <select asp-for="Gender" class="form-select" required>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Size" class="form-label">Size</label>
                                <select asp-for="Size" class="form-select" required>
                                    <option value="Small">Small</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Large">Large</option>
                                </select>
                                <span asp-validation-for="Size" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Color" class="form-label">Color</label>
                                <input asp-for="Color" class="form-control" required />
                                <span asp-validation-for="Color" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="Available">Available</option>
                                <option value="Pending">Pending</option>
                                <option value="Adopted">Adopted</option>
                                <option value="MedicalHold">Medical Hold</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        @if (Model.PhotoUrls != null && Model.PhotoUrls.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label">Current Photo</label>
                                <div>
                                    <img src="@Model.PhotoUrls.First()" alt="@Model.Name" class="img-thumbnail" style="max-height: 200px;">
                                </div>
                            </div>
                        }

                        <input type="hidden" asp-for="PhotoUrls" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="Vaccinated" class="form-check-input" type="checkbox" />
                                    <label asp-for="Vaccinated" class="form-check-label">Vaccinated</label>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="Neutered" class="form-check-input" type="checkbox" />
                                    <label asp-for="Neutered" class="form-check-label">Neutered/Spayed</label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="GoodWithKids" class="form-check-input" type="checkbox" />
                                    <label asp-for="GoodWithKids" class="form-check-label">Good with Kids</label>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="GoodWithPets" class="form-check-input" type="checkbox" />
                                    <label asp-for="GoodWithPets" class="form-check-label">Good with Other Pets</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">Update Pet</button>
                            <a asp-action="Details" asp-route-id="@Model.PetId" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
