@* Medical Record Form Section - Shared between Create and Edit *@


@{
    bool isCreateView = ViewData.ModelMetadata?.ModelType?.Name == "CreatePetViewModel";
    string labelText = isCreateView ? "Add Initial Medical Record (Optional)" : "Add New Medical Record (Optional)";
}

<!-- Medical Record Section -->
<div class="card mb-3">
    <div class="card-header bg-info text-white">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="createMedicalRecord" name="CreateMedicalRecord" value="true" />
            <label class="form-check-label text-white" for="createMedicalRecord">
                <strong>@labelText</strong>
            </label>
        </div>
    </div>
    <div class="card-body" id="medicalRecordSection" style="display: none;">
        <div class="mb-3">
            <label for="MedicalRecordType" class="form-label">Record Type</label>
            <select id="MedicalRecordType" name="MedicalRecordType" class="form-select">
                <option value="">-- Select Type --</option>
                <option value="General Checkup">General Checkup</option>
                <option value="Vaccination">Vaccination</option>
                <option value="Treatment">Treatment</option>
                <option value="Follow-up">Follow-up</option>
                <option value="Surgery">Surgery</option>
            </select>
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordType" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label for="MedicalRecordDate" class="form-label">Record Date</label>
            <input id="MedicalRecordDate" name="MedicalRecordDate" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordDate" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label for="MedicalRecordDescription" class="form-label">Description</label>
            <textarea id="MedicalRecordDescription" name="MedicalRecordDescription" class="form-control" rows="3" placeholder="Describe the medical record..."></textarea>
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordDescription" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3" id="vaccineNameSection" style="display: none;">
            <label for="MedicalRecordVaccineName" class="form-label">Vaccine Name</label>
            <input id="MedicalRecordVaccineName" name="MedicalRecordVaccineName" class="form-control" placeholder="e.g., DHPP, Rabies, etc." />
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordVaccineName" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label for="MedicalRecordNextDueDate" class="form-label">Next Due Date (Optional)</label>
            <input id="MedicalRecordNextDueDate" name="MedicalRecordNextDueDate" type="date" class="form-control" />
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordNextDueDate" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label for="MedicalRecordCost" class="form-label">Cost (Optional)</label>
            <input id="MedicalRecordCost" name="MedicalRecordCost" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordCost" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label for="MedicalRecordNotes" class="form-label">Notes (Optional)</label>
            <textarea id="MedicalRecordNotes" name="MedicalRecordNotes" class="form-control" rows="2" placeholder="Additional notes..."></textarea>
            <span class="text-danger field-validation-valid" data-valmsg-for="MedicalRecordNotes" data-valmsg-replace="true"></span>
        </div>
    </div>
</div>

