@model Pet.Web.Models.ViewModels.PetViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            @if (Model.PhotoUrls != null && Model.PhotoUrls.Any())
            {
                <img src="@Model.PhotoUrls.First()" class="img-fluid rounded shadow mb-4" alt="@Model.Name" style="max-height: 500px; width: 100%; object-fit: contain;">
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded mb-4" style="height: 400px;">
                    <span class="text-white h3">No Image Available</span>
                </div>
            }
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <h2>@Model.Name</h2>
            <span class="badge bg-@(Model.Status == "Available" ? "success" : "warning") mb-3">@Model.Status</span>

            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Basic Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Species:</dt>
                        <dd class="col-sm-7">@Model.Species</dd>

                        <dt class="col-sm-5">Breed:</dt>
                        <dd class="col-sm-7">@Model.Breed</dd>

                        <dt class="col-sm-5">Age:</dt>
                        <dd class="col-sm-7">@Model.Age year(s)</dd>

                        <dt class="col-sm-5">Gender:</dt>
                        <dd class="col-sm-7">@Model.Gender</dd>

                        <dt class="col-sm-5">Size:</dt>
                        <dd class="col-sm-7">@Model.Size</dd>

                        <dt class="col-sm-5">Color:</dt>
                        <dd class="col-sm-7">@Model.Color</dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Health & Behavior</h5>
                </div>
                <div class="card-body">
                    <p>
                        <strong>Vaccinated:</strong>
                        @if (Model.Vaccinated)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </p>
                    <p>
                        <strong>Neutered/Spayed:</strong>
                        @if (Model.Neutered)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </p>
                    <p>
                        <strong>Good with Kids:</strong>
                        @if (Model.GoodWithKids)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">No</span>
                        }
                    </p>
                    <p>
                        <strong>Good with Other Pets:</strong>
                        @if (Model.GoodWithPets)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">No</span>
                        }
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Description</h5>
                </div>
                <div class="card-body">
                    <p>@Model.Description</p>
                </div>
            </div>

            @{
                var medicalRecords = ViewBag.MedicalRecords as List<Pet.Web.Models.ViewModels.MedicalRecordViewModel> ?? new List<Pet.Web.Models.ViewModels.MedicalRecordViewModel>();
            }

            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Medical Records</h5>
                </div>
                <div class="card-body">
                    @if (medicalRecords.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Veterinarian</th>
                                        <th>Description</th>
                                        <th>Vaccine</th>
                                        <th>Next Due</th>
                                        <th>Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in medicalRecords)
                                    {
                                        <tr>
                                            <td>@record.RecordDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-info">@record.RecordType</span>
                                            </td>
                                            <td>@record.VeterinarianName</td>
                                            <td>@record.Description</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(record.VaccineName))
                                                {
                                                    <span class="badge bg-primary">@record.VaccineName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (record.NextDueDate.HasValue)
                                                {
                                                    <span class="@(record.NextDueDate.Value < DateTime.UtcNow ? "text-danger" : record.NextDueDate.Value < DateTime.UtcNow.AddDays(30) ? "text-warning" : "")">
                                                        @record.NextDueDate.Value.ToString("MMM dd, yyyy")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>$@record.Cost.ToString("F2")</td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(record.Notes))
                                        {
                                            <tr>
                                                <td colspan="7" class="text-muted small">
                                                    <strong>Notes:</strong> @record.Notes
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No medical records available for this pet.</p>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 mb-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>

                @if (Model.Status == "Available" && Context.Session.GetString("UserId") != null)
                {
                    <a asp-controller="Adoptions" asp-action="Create" asp-route-petId="@Model.PetId" class="btn btn-success">
                        Apply for Adoption
                    </a>
                }

                @if (Context.Session.GetString("Role") == "Staff" || Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-action="Edit" asp-route-id="@Model.PetId" class="btn btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@Model.PetId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this pet?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                }
            </div>

            <small class="text-muted">
                Intake Date: @Model.IntakeDate.ToString("MMMM dd, yyyy")
            </small>
        </div>
    </div>
</div>
