@model List<Pet.Web.Models.ViewModels.MedicalRecordViewModel>

@* Edit Medical Record Modals *@
@foreach (var record in Model)
{
    <div class="modal fade" id="editRecordModal_@record.RecordId" tabindex="-1" aria-labelledby="editRecordModalLabel_@record.RecordId" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editRecordModalLabel_@record.RecordId">Edit Medical Record</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editRecordForm_@record.RecordId" class="medical-record-form">
                    <div class="modal-body">
                        <input type="hidden" name="RecordId" value="@record.RecordId" />
                        <input type="hidden" name="PetId" value="@record.PetId" />
                        <input type="hidden" name="PetName" value="@record.PetName" />
                        <input type="hidden" name="CreatedDate" value="@record.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss")" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Record Type <span class="text-danger">*</span></label>
                                <select name="RecordType" class="form-select" required>
                                    @if (record.RecordType == "Vaccination")
                                    {
                                        <option value="Vaccination" selected>Vaccination</option>
                                    }
                                    else
                                    {
                                        <option value="Vaccination">Vaccination</option>
                                    }
                                    @if (record.RecordType == "General Checkup")
                                    {
                                        <option value="General Checkup" selected>General Checkup</option>
                                    }
                                    else
                                    {
                                        <option value="General Checkup">General Checkup</option>
                                    }
                                    @if (record.RecordType == "Treatment")
                                    {
                                        <option value="Treatment" selected>Treatment</option>
                                    }
                                    else
                                    {
                                        <option value="Treatment">Treatment</option>
                                    }
                                    @if (record.RecordType == "Follow-up")
                                    {
                                        <option value="Follow-up" selected>Follow-up</option>
                                    }
                                    else
                                    {
                                        <option value="Follow-up">Follow-up</option>
                                    }
                                    @if (record.RecordType == "Surgery")
                                    {
                                        <option value="Surgery" selected>Surgery</option>
                                    }
                                    else
                                    {
                                        <option value="Surgery">Surgery</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Record Date <span class="text-danger">*</span></label>
                                <input type="datetime-local" name="RecordDate" class="form-control" value="@record.RecordDate.ToString("yyyy-MM-ddTHH:mm")" required />
                            </div>
                        </div>

                        <input type="hidden" name="VeterinarianId" value="@record.VeterinarianId" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Veterinarian Name</label>
                                <input type="text" name="VeterinarianName" class="form-control" value="@record.VeterinarianName" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" rows="3">@record.Description</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Vaccine Name</label>
                                <input type="text" name="VaccineName" class="form-control" value="@record.VaccineName" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Next Due Date</label>
                                <input type="datetime-local" name="NextDueDate" class="form-control" value="@(record.NextDueDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cost</label>
                                <input type="number" name="Cost" class="form-control" step="0.01" min="0" value="@record.Cost" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Notes</label>
                            <textarea name="Notes" class="form-control" rows="3">@record.Notes</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

