@model List<Pet.Web.Models.ViewModels.PetViewModel>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Pets for Adoption</h2>
        @if (Context.Session.GetString("Role") == "Staff" || Context.Session.GetString("Role") == "Admin")
        {
            <a asp-controller="Pets" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Pet
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h4>No pets available for adoption at the moment</h4>
            <p>Please check back later for new arrivals!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var pet in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (pet.PhotoUrls != null && pet.PhotoUrls.Any())
                        {
                            <img src="@pet.PhotoUrls.First()" class="card-img-top" alt="@pet.Name" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 250px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@pet.Name</h5>
                            <p class="card-text">
                                <strong>Species:</strong> @pet.Species<br />
                                <strong>Breed:</strong> @pet.Breed<br />
                                <strong>Age:</strong> @pet.Age year(s)<br />
                                <strong>Gender:</strong> @pet.Gender<br />
                                <span class="badge bg-@(pet.Status == "Pending" ? "warning" : pet.Status == "Available" ? "success" : "secondary")">@pet.Status</span>
                            </p>
                            <p class="card-text text-truncate">@pet.Description</p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.PetId" class="btn btn-outline-primary btn-sm">View Details</a>

                            @if (Context.Session.GetString("Role") == "Staff" || Context.Session.GetString("Role") == "Admin")
                            {
                                <a asp-controller="Pets" asp-action="Edit" asp-route-id="@pet.PetId" class="btn btn-outline-secondary btn-sm">Edit</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
