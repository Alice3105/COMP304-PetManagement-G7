@model Pet.Web.Models.ViewModels.CreateAdoptionViewModel

@{
    ViewData["Title"] = $"Edit Adoption Application for {ViewBag.PetName}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Edit Adoption Application for @ViewBag.PetName</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Edit your adoption application</strong><br />
                        You can update your application details below. Note: You can only edit applications with Pending status.
                    </div>

                    <form asp-action="Edit" asp-route-id="@ViewBag.AdoptionId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PetId" value="@ViewBag.PetId" />

                        <h5 class="mt-3 mb-3">Contact Information</h5>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="(123) 456-7890" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Full Address <span class="text-danger">*</span></label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street, City, State, ZIP" required></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 mb-3">Housing Information</h5>

                        <div class="mb-3">
                            <label asp-for="HousingType" class="form-label">Housing Type <span class="text-danger">*</span></label>
                            <select asp-for="HousingType" class="form-select" required>
                                <option value="">-- Select --</option>
                                <option value="House">House</option>
                                <option value="Apartment">Apartment</option>
                                <option value="Condo">Condo</option>
                                <option value="Townhouse">Townhouse</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="HousingType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="HasYard" class="form-check-input" type="checkbox" />
                                <label asp-for="HasYard" class="form-check-label">I have a yard</label>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3">Household Information</h5>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="HasOtherPets" class="form-check-input" type="checkbox" id="hasOtherPetsCheck" />
                                <label asp-for="HasOtherPets" class="form-check-label">I have other pets</label>
                            </div>
                        </div>

                        <div class="mb-3" id="otherPetsDiv" style="display: @(Model.HasOtherPets ? "block" : "none");">
                            <label asp-for="OtherPetsDescription" class="form-label">Please describe your other pets <span class="text-danger" id="otherPetsRequired" style="display: @(Model.HasOtherPets ? "inline" : "none");">*</span></label>
                            @if (Model.HasOtherPets)
                            {
                                <textarea asp-for="OtherPetsDescription" id="otherPetsDescription" class="form-control" rows="2" placeholder="e.g., 2 dogs, 1 cat" required></textarea>
                            }
                            else
                            {
                                <textarea asp-for="OtherPetsDescription" id="otherPetsDescription" class="form-control" rows="2" placeholder="e.g., 2 dogs, 1 cat"></textarea>
                            }
                            <span asp-validation-for="OtherPetsDescription" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="HasChildren" class="form-check-input" type="checkbox" id="hasChildrenCheck" />
                                <label asp-for="HasChildren" class="form-check-label">I have children</label>
                            </div>
                        </div>

                        <div class="mb-3" id="childrenAgesDiv" style="display: @(Model.HasChildren ? "block" : "none");">
                            <label asp-for="ChildrenAges" class="form-label">Ages of children <span class="text-danger" id="childrenAgesRequired" style="display: @(Model.HasChildren ? "inline" : "none");">*</span></label>
                            @if (Model.HasChildren)
                            {
                                <input asp-for="ChildrenAges" id="childrenAges" class="form-control" placeholder="e.g., 5, 8, 12" required />
                            }
                            else
                            {
                                <input asp-for="ChildrenAges" id="childrenAges" class="form-control" placeholder="e.g., 5, 8, 12" />
                            }
                            <span asp-validation-for="ChildrenAges" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmploymentStatus" class="form-label">Employment Status <span class="text-danger">*</span></label>
                            <select asp-for="EmploymentStatus" class="form-select" required>
                                <option value="">-- Select --</option>
                                <option value="Full-time">Full-time</option>
                                <option value="Part-time">Part-time</option>
                                <option value="Self-employed">Self-employed</option>
                                <option value="Retired">Retired</option>
                                <option value="Student">Student</option>
                                <option value="Unemployed">Unemployed</option>
                            </select>
                            <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 mb-3">About You</h5>

                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label">Why do you want to adopt @ViewBag.PetName? <span class="text-danger">*</span></label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Tell us why you're interested in adopting this pet and what you can offer them..." required></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">Update Application</button>
                            <a asp-action="Details" asp-route-id="@ViewBag.AdoptionId" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/adoption-form.js"></script>
}

