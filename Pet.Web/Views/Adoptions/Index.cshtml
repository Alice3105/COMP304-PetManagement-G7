@model List<Pet.Web.Models.ViewModels.AdoptionViewModel>

@{
    ViewData["Title"] = "Adoption Applications";
    var role = Context.Session.GetString("Role");
    var isStaff = (role == "Staff" || role == "Admin");
}

<div class="container mt-4">
    <h2>@(isStaff ? "All Adoption Applications" : "My Adoption Applications")</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info mt-4">
            <h4>No adoption applications found</h4>
            <p>@(isStaff ? "No applications have been submitted yet." : "You haven't submitted any adoption applications yet.")</p>
            @if (!isStaff)
            {
                <a asp-controller="Pets" asp-action="Index" class="btn btn-primary">Browse Available Pets</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive mt-4">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Pet</th>
                        @if (isStaff)
                        {
                            <th>Applicant</th>
                        }
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var adoption in Model)
                    {
                        <tr>
                            <td>@adoption.ApplicationDate.ToString("MMM dd, yyyy")</td>
                            <td>@adoption.PetName</td>
                            @if (isStaff)
                            {
                                <td>@adoption.UserFirstName @adoption.UserLastName</td>
                            }
                            <td>
                                @if (adoption.Status == "Pending")
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else if (adoption.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (adoption.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@adoption.AdoptionId" class="btn btn-sm btn-primary">View Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
